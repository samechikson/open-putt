rules_version = '2';

// Access model:
//   * The web app and the iOS app read and write Firestore **directly** via the
//     Firebase SDK, so these rules are the enforcement boundary: a signed-in user
//     may only touch documents whose `user_id` is their own uid.
//   * The iOS app relays hardware-gate putts, so it *creates* sessions and putts
//     (scoped to itself). The web app only reads them, edits session metadata, or
//     deletes them — but the rules can't tell the two clients apart, so any
//     signed-in user may create their own sessions/putts.
//   * The backend (the legacy ESP32 direct-post ingest path) uses the Admin SDK,
//     which **bypasses these rules**.
//
// `get` (and `delete`) allow a *non-existent* doc (resource == null): iOS ingest
// does a create-if-absent read on a session's first putt, and that read must
// return "not found" rather than be denied. `list` stays strictly ownership-
// scoped (a query must filter `user_id == uid`), since list results always exist.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // The existing doc is owned by the caller — or doesn't exist yet (a get on a
    // missing doc, or an idempotent delete, reveals nothing).
    function ownsOrAbsent() {
      return resource == null || resource.data.user_id == request.auth.uid;
    }
    // The incoming doc is owned by the caller (create/update can't set or move
    // ownership to someone else).
    function ownsIncoming() {
      return request.resource.data.user_id == request.auth.uid;
    }
    // A list query must be constrained to the caller's own docs.
    function ownsListed() {
      return resource.data.user_id == request.auth.uid;
    }

    match /putters/{putterId} {
      allow get, delete: if signedIn() && ownsOrAbsent();
      allow list: if signedIn() && ownsListed();
      allow create: if signedIn() && ownsIncoming();
      allow update: if signedIn() && ownsOrAbsent() && ownsIncoming();
    }

    match /sessions/{sessionId} {
      allow get, delete: if signedIn() && ownsOrAbsent();
      allow list: if signedIn() && ownsListed();
      allow create: if signedIn() && ownsIncoming();
      allow update: if signedIn() && ownsOrAbsent() && ownsIncoming();
    }

    match /putts/{puttId} {
      allow get, delete: if signedIn() && ownsOrAbsent();
      allow list: if signedIn() && ownsListed();
      allow create: if signedIn() && ownsIncoming();
      allow update: if signedIn() && ownsOrAbsent() && ownsIncoming();
    }
  }
}
