rules_version = '2';

// Access model:
//   * The web app and the iOS app read and write Firestore **directly** via the
//     Firebase SDK, so these rules are the enforcement boundary: a signed-in user
//     may only touch documents whose `user_id` is their own uid.
//   * The iOS app relays hardware-gate putts, so it *creates* sessions and putts
//     (scoped to itself). The web app only reads them, edits session metadata, or
//     deletes them — but the rules can't tell the two clients apart, so any
//     signed-in user may create their own sessions/putts.
//   * The backend (the legacy ESP32 direct-post ingest path) uses the Admin SDK,
//     which **bypasses these rules**.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // The existing doc belongs to the caller.
    function owns(res) {
      return signedIn() && res.data.user_id == request.auth.uid;
    }
    // The incoming doc is owned by the caller (create/update can't set or move
    // ownership to someone else).
    function ownsIncoming() {
      return signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // Putters: full CRUD by the owner (the web app manages these).
    match /putters/{putterId} {
      allow read, delete: if owns(resource);
      allow create: if ownsIncoming();
      allow update: if owns(resource) && ownsIncoming();
    }

    // Sessions: the iOS app creates one per gate run (on its first putt) and
    // keeps its putt_count in sync; the web app edits metadata or deletes. A
    // create/update can't set or move ownership to someone else.
    match /sessions/{sessionId} {
      allow read, delete: if owns(resource);
      allow create: if ownsIncoming();
      allow update: if owns(resource) && ownsIncoming();
    }

    // Putts: the iOS app writes them on ingest (idempotent per session+index);
    // either client can read its own and delete a putt (a mishit / false trip).
    match /putts/{puttId} {
      allow read, delete: if owns(resource);
      allow create: if ownsIncoming();
      allow update: if owns(resource) && ownsIncoming();
    }
  }
}
